{
  "name": "salamat-projects-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "tsx --test tests/**/*.test.ts",
    "task-packet:harness": "tsx scripts/task-packet-harness.ts",
    "sync:github": "tsx scripts/sync-github-projects.ts",
    "sync:github:watch": "tsx scripts/sync-github-projects.ts --output config/projects.github.json --watch 60",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name salamat-projects-dashboard --branch main",
    "deploy:cloudflare:list": "wrangler pages deployment list --project-name salamat-projects-dashboard",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.34.1",
    "@xyflow/react": "^12.11.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.128.0"
  }
}
