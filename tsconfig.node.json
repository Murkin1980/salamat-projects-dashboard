{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.ts",
    "src/adapters/github-source.ts",
    "src/contract/project-state.ts",
    "src/contract/task-packet.ts",
    "src/discovery/discovery-analytics.ts"
  ]
}
